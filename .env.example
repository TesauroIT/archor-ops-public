# Copia este archivo a .env y ajusta los valores.

# SQLite para uso local sin infraestructura extra.
# En el servidor interno (multiples clientes), cambiar a postgresql y
# actualizar el "provider" en prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# Encriptacion de tokens de Dynatrace (AES-256-GCM).
# Debe ser exactamente 64 caracteres hex (32 bytes). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="reemplazar-con-64-caracteres-hexadecimales"

# Ruta al binario de Monaco CLI instalado en este servidor/maquina.
MONACO_BIN_PATH="monaco"

# Carpeta base donde viven los repos Git locales de cada cliente/entorno.
DATA_DIR="./data"

# Credenciales del admin sembrado por prisma/seed.ts (correr una sola vez).
SEED_ADMIN_EMAIL="admin@local"
SEED_ADMIN_PASSWORD="cambia-esta-password"
